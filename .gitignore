
# ==============================================================================
# GuitarTab AI — Production .gitignore
# ==============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.installed.cfg
*.egg

# Python build artifacts
/backend/build/
/backend/dist/
backend/wheels/

# Virtual environments
.venv/
venv/
ENV/
env/

# Testing and coverage
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.cover

# Node dependencies
node_modules/

# Frontend generated builds
/frontend/dist/
/guitartab-lovable/dist/
/guitartab-lovable/.output/
/guitartab-lovable/.wrangler/

# Environment files and secrets
.env
.env.*
!.env.example
!.env.*.example

# Data: uploads and generated processing
data/uploads/*
!data/uploads/.gitkeep

data/processed/*
!data/processed/.gitkeep

data/annotations/*
!data/annotations/.gitkeep

# Large training datasets
data/raw/*
!data/raw/.gitkeep

data/extracted_fretboard/

# Evaluation artifacts
scratch/vision_eval/
runs/

# Model weights
*.pth
*.onnx
*.pt

# Required runtime checkpoint
!backend/models/
!backend/models/fretboard_rcnn.pt

# TabVision source is a required Git submodule.
# Never ignore scratch/tab_vision/

# Temporary scratch outputs
scratch/*.tab
scratch/*.log
scratch/*.mp4
scratch/*.wav

# Media files
*.mp4
*.wav
*.mp3

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# IDE files
.idea/
.vscode/

# Editor temporary files
*.swp
*.swo
*~

# Logs
*.log

# Local helper files
cmd.txt
old__.gitignore
