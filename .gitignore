# ==============================================================================
# GuitarTab AI — Production .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python & Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments (local to each machine and OS)
.venv/
venv/
ENV/
env/
backend/.venv/
scratch/tab_vision/tabvision/.venv/
scratch/tab_vision/.venv/

# Testing & Coverage
.cache
.pytest_cache/
backend/.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.cover

# ------------------------------------------------------------------------------
# 2. Node & Frontends
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
guitartab-lovable/node_modules/

# Frontend Build Outputs
frontend/dist/
guitartab-lovable/dist/
guitartab-lovable/.output/
guitartab-lovable/.wrangler/

# ------------------------------------------------------------------------------
# 3. Environment & Local Secrets
# ------------------------------------------------------------------------------
.env
.env*.local
backend/.env
frontend/.env
guitartab-lovable/.env.local
guitartab-lovable/.env*.local
!.env.example
!backend/.env.example
!frontend/.env.example

# ------------------------------------------------------------------------------
# 4. Data, Uploads & Processed Job Artifacts
# ------------------------------------------------------------------------------
# Uploaded video files and processing results
data/uploads/*
!data/uploads/.gitkeep

data/processed/*
!data/processed/.gitkeep

data/annotations/*
!data/annotations/.gitkeep

# Large training dataset zip (4.3 GB archive)
data/raw/guitar-transcription-dataset.zip

# Evaluation artifacts
data/processed/evaluation/
scratch/vision_eval/
runs/

# ------------------------------------------------------------------------------
# 5. Model Checkpoints & Weights
# ------------------------------------------------------------------------------
# Ignore generic weight formats by default
*.pth
*.onnx

# Allow the required runtime model checkpoint
*.pt
!backend/models/fretboard_rcnn.pt

# ------------------------------------------------------------------------------
# 6. TabVision & Scratch Areas
# ------------------------------------------------------------------------------
# NOTE: Do NOT ignore scratch/tab_vision/ (submodule source)
scratch/*.tab
scratch/*.log
scratch/*.mp4
scratch/*.wav

# ------------------------------------------------------------------------------
# 7. OS & Editor Files
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
*.log
old__.gitignore
cmd.txt
